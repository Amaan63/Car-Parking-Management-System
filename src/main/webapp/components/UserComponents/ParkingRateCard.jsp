<!-- Parking Rate Card -->
<div class="container py-5">
	<div class="row g-4">
		<div class="col-md-12 mx-auto">
			<!-- Matches the width like other sections -->
			<div class="card bg-dark text-white">
				<div class="card-header bg-warning">
					<h5 class="card-title mb-0 text-dark">Current Parking Rates</h5>
				</div>
				<div class="card-body">
					<div class="row g-4">
						<!-- Hourly Rate -->
						<div class="col-md-4">
							<div
								class="border rounded p-3 text-center bg-dark text-white h-100">
								<h5 class="text-primary mb-3">Hourly Rate</h5>
								<div class="display-6 mb-2">$2.00</div>
								<div class="small text-muted">Charged per hour</div>
							</div>
						</div>

						<!-- Operating Hours -->
						<div class="col-md-4">
							<div class="border rounded p-3 bg-dark text-white h-100">
								<h5 class="text-primary mb-3">
									<i class="fas fa-clock me-1"></i> Operating Hours
								</h5>
								<ul class="list-unstyled mb-0">
									<li><strong>Mon - Fri:</strong> 6:00 AM - 10:00 PM</li>
									<li><strong>Sat - Sun:</strong> 8:00 AM - 11:00 PM</li>
								</ul>
							</div>
						</div>

						<!-- Security & Services -->
						<div class="col-md-4">
							<div class="border rounded p-3 bg-dark text-white h-100">
								<h5 class="text-primary mb-3">
									<i class="fas fa-shield-alt me-1"></i> Security & Services
								</h5>
								<ul class="list-unstyled mb-0">
									<li><i class="fas fa-video me-1"></i> 24/7 Surveillance</li>
									<li><i class="fas fa-user-shield me-1"></i> On-site
										Security</li>
									<li><i class="fas fa-charging-station me-1"></i> EV
										Charging Stations</li>
								</ul>
							</div>
						</div>
					</div>

					<!-- Info Alert -->
					<div class="alert alert-info mt-3 mb-0">
						<i class="fas fa-info-circle me-1"></i> Monthly parking
						subscriptions are available. Contact customer service for details.
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
